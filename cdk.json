{
  "app": "python3 app.py",

  "//": "Files/folders the CDK CLI ignores when it watches or bundles the app.",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/__init__.py",
      "**/__pycache__",
      ".venv",
      "tests"
    ]
  },

  "context": {
    "//": "===================================================================",
    "//1": "APPLICATION SETTINGS (read by basic_webapp/config.py).",
    "//2": "Anything in here can be overridden on the command line, e.g.",
    "//3": "   cdk deploy -c env=prod",
    "//4": "   cdk deploy -c env=dev -c certificate_arn=arn:aws:acm:...",
    "//5": "===================================================================",

    "env": "dev",

    "project_name": "basic-webapp",
    "owner": "platform-engineering",

    "environments": {
      "dev": {
        "vpc_cidr": "10.20.0.0/16",
        "max_azs": 2,
        "nat_gateways": 1,
        "instance_type": "t3.micro",
        "asg_min_capacity": 2,
        "asg_max_capacity": 4,
        "task_desired_count": 2,
        "task_min_count": 2,
        "task_max_count": 4,
        "container_image": "amazon/amazon-ecs-sample",
        "container_port": 80,
        "enable_database": true,
        "db_instance_type": "t3.micro",
        "db_multi_az": false,
        "db_performance_insights": false,
        "enable_private_link_endpoints": false,
        "retain_data_on_delete": false,
        "log_retention_days": 7
      },
      "prod": {
        "vpc_cidr": "10.30.0.0/16",
        "max_azs": 3,
        "nat_gateways": 3,
        "instance_type": "m6i.large",
        "asg_min_capacity": 2,
        "asg_max_capacity": 4,
        "task_desired_count": 2,
        "task_min_count": 2,
        "task_max_count": 4,
        "container_image": "amazon/amazon-ecs-sample",
        "container_port": 80,
        "enable_database": true,
        "db_instance_type": "t3.small",
        "db_multi_az": true,
        "db_performance_insights": true,
        "enable_private_link_endpoints": true,
        "retain_data_on_delete": true,
        "log_retention_days": 90
      }
    },

    "//6": "=== CDK feature flags: keep newer, safer behaviours turned on. ===",
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentControllerForCircuitBreaker": true,
    "@aws-cdk/aws-ecs:reduceEc2FargateCloudWatchPermissions": true,
    "@aws-cdk/aws-rds:auroraClusterChangeScopeOfInstanceParameterGroupWithEachParameters": true,
    "@aws-cdk/aws-elasticloadbalancingv2:albDualstackWithoutPublicIpv4SecurityGroupRulesDefault": true,
    "@aws-cdk/aws-autoscaling:generateLaunchTemplateInsteadOfLaunchConfig": true
  }
}
